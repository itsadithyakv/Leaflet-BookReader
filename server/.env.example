# Leaflet API server -- local development.
#
# This is the only place a Mongo connection string may live. The app must never
# hold one: it would let any reader read and write every other reader's data.
# In production these come from /etc/leaflet-api.env (see deploy/).

# Local MongoDB, or Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=leaflet
# Password reset emails (optional): see deploy/password-reset-mailer.gs.
# RESET_MAIL_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# RESET_MAIL_SECRET=

# Where to listen. Keep HOST on loopback; Caddy proxies to it in production.
HOST=127.0.0.1
PORT=8787

# Only needed to call the API from a browser page. Leave empty for the app.
CORS_ORIGIN=
