# /etc/leaflet-backup.env  (owner root:root, chmod 600 -- systemd reads it as root)
#
# The nightly backup's settings; MONGO_URI and MONGO_DB come from
# /etc/leaflet-api.env. See docs/backups.md. Never commit the real file.

# The "Leaflet backups" Apps Script web app in the leafletmail account
# (deploy/backup-receiver.gs), and its SECRET Script Property.
BACKUP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
BACKUP_SECRET=the-same-long-random-string-as-the-script-property

# The owner's public key (keygen.js wrote it as backup-private.pub). Not a
# secret; readable by the leaflet user: install -m 644. Never the private key.
BACKUP_PUBLIC_KEY=/etc/leaflet-backup.pub

# Optional: the size of each part sent, in MB (1 to 8; default 8). Lower it if
# the receiver ever fails on large parts.
# BACKUP_PART_MB=8
