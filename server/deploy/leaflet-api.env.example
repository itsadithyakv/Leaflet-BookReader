# /etc/leaflet-api.env  (owner root:root, chmod 600 -- systemd reads it as root)
#
# The only place the Atlas connection string lives. Never commit the real file.

# MongoDB Atlas (free tier). Allowlist the VM's static public IP under
# Atlas -> Network Access. Use a database user limited to this one database.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=leaflet

# Password reset (optional). A Google Apps Script web app sends the emails from
# your Gmail; see deploy/password-reset-mailer.gs. Without both, reset is off.
RESET_MAIL_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
RESET_MAIL_SECRET=the-same-long-random-string-as-the-script-property

# Caddy proxies to this. Keep HOST on loopback so the API is never exposed directly.
HOST=127.0.0.1
PORT=8787
