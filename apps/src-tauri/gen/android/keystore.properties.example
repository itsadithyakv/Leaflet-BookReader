# Copy to keystore.properties (beside this file; git ignores it) to sign
# release builds with the upload key. Keep the key itself outside the repo,
# backed up. See docs/android.md, "Signing for Google Play".
#
# storeFile may be absolute (forward slashes, or doubled backslashes) or
# relative to this folder.
storeFile=C:/Users/you/keys/leaflet-upload.jks
storePassword=the-keystore-password
keyAlias=upload
keyPassword=the-key-password
