{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": [
      "resources/**/*"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "name": "EPUB book",
        "description": "EPUB book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": ["mobi"],
        "name": "Mobipocket book",
        "description": "Mobipocket book",
        "mimeType": "application/x-mobipocket-ebook",
        "role": "Viewer"
      },
      {
        "ext": ["azw3"],
        "name": "Kindle book",
        "description": "Kindle book",
        "mimeType": "application/vnd.amazon.ebook",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "productName": "Leaflet",
  "version": "1.4.0",
  "identifier": "com.leaflet.app",
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "Leaflet",
        "width": 1600,
        "height": 1000,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": "default-src * ipc: http://ipc.localhost data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src * ipc: http://ipc.localhost ws: wss: data: blob:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": [
        "default"
      ]
    }
  }
}
