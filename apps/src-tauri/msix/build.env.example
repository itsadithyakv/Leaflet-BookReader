# The values a release build compiles in. Copy this file to `build.env` (in
# this folder; git ignores it), fill in the two Google values, and
# `.\build-msix.ps1` reads them every time. A value set in the PowerShell
# window itself wins over the one here.
#
# The two Google values are the desktop OAuth client's, from
# console.cloud.google.com (APIs & Services, Credentials). Without them the
# package has no Drive backup.
LEAFLET_GOOGLE_CLIENT_ID=
LEAFLET_GOOGLE_CLIENT_SECRET=

# Not secrets: which features the package ships with, and the API's address
# for an app that cannot reach the signed config.
VITE_ENABLE_ACCOUNTS=true
VITE_ENABLE_COMMUNITY=true
LEAFLET_API_BASE=https://leafletapp.duckdns.org
