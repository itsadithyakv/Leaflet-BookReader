# Leaflet environment
#
# Copy to `apps/.env` for development. The Tauri backend calls
# `dotenvy::dotenv()` at startup in debug builds, so these reach `std::env` when the app is run
# from the repo.
#
# For a RELEASE build, set them in the build environment instead: they are read
# at compile time via `option_env!` and baked into the binary. A packaged app is
# launched from wherever the user's shortcut points, finds no `.env` there, and
# would otherwise have no credentials at all.

# Google Drive sync. Create an OAuth client of type "Desktop app" in the Google
# Cloud console. The scope used is `drive.file`, which is non-sensitive: Leaflet
# can only see files it created, and no Google security assessment is required.
#
# Google treats desktop clients as public — the secret cannot be kept inside a
# binary users hold — which is why PKCE is used and required.
#
# Drive sync is optional. Folder sync needs none of this.
LEAFLET_GOOGLE_CLIENT_ID=
LEAFLET_GOOGLE_CLIENT_SECRET=

# The Leaflet API (accounts, leaderboards, shared shelves). Optional: backup
# works without it. Compiled into the Rust side as the default server (like the
# Google client id above); a device can still override it in Settings. Must be
# https://, except http://localhost or http://127.0.0.1 for development.
#
# The Mongo connection string does NOT belong here -- it lives on the server,
# because the app must never hold one. See server/README.md.
LEAFLET_API_BASE=

# Release switches (see src/constants/features.ts). Both default to off, which is
# the desktop launch: Drive is a backup, the mobile app is "coming soon", and
# leaderboards stay hidden until a hosted server exists.
VITE_ENABLE_MULTI_DEVICE=
VITE_ENABLE_COMMUNITY=
# Optional email + password accounts (Settings -> Account). Shown only when this
# is "true" AND an API base is configured.
VITE_ENABLE_ACCOUNTS=
